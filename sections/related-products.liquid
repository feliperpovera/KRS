<related-products
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
  class="section-padding"
  style="display:block"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <carousel-slider>
        <div class="section-header">
          <h2 class="section-header__title">{{ section.settings.heading | escape }}</h2>
          <div class="carousel-nav">
            <button type="button" data-carousel-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
              {% render 'icon', icon: 'arrow-left' %}
            </button>
            <button type="button" data-carousel-next aria-label="{{ 'accessibility.next_slide' | t }}">
              {% render 'icon', icon: 'arrow-right' %}
            </button>
          </div>
        </div>
        <ul class="carousel" role="list">
          {%- for recommendation in recommendations.products -%}
            <li>{% render 'product-card', card_product: recommendation %}</li>
          {%- endfor -%}
        </ul>
      </carousel-slider>
    </div>
  {%- endif -%}
</related-products>

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 10,
      "step": 1,
      "label": "Products to show",
      "default": 8
    }
  ]
}
{% endschema %}
