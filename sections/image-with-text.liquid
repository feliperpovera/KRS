<div class="section-padding">
  <div class="page-width">
    <div class="image-with-text{% if section.settings.layout == 'reverse' %} image-with-text--reverse{% endif %}">
      <div class="image-with-text__media scroll-trigger">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '550, 750, 1100, 1500', alt: section.settings.image.alt
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="image-with-text__content scroll-trigger">
        {%- if section.settings.subheading != blank -%}
          <p style="letter-spacing:.2em;text-transform:uppercase;font-size:1.2rem;opacity:.6;margin:0 0 1rem;">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {{ section.settings.text }}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--secondary">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Recommended: 1200 x 1500 px"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "default", "label": "Left" },
        { "value": "reverse", "label": "Right" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow",
      "default": "Editorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Seasonal essentials"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Versatile pieces made for every day: from your workout to the street without losing style.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
