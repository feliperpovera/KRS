<div id="MainCart" class="cart-page section-padding">
  <div class="page-width">
    <h1>{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <div class="cart-page__grid">
        <div>
          {%- for item in cart.items -%}
            <div class="cart-item">
              <a href="{{ item.url }}" class="cart-item__image">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.image.alt }}
                {%- else -%}
                  {{ 'product-apparel-2' | placeholder_svg_tag }}
                {%- endif -%}
              </a>
              <div>
                <p class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></p>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__meta">{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                <div class="cart-item__row">
                  <div class="quantity">
                    <button
                      type="button"
                      data-cart-change
                      data-line="{{ forloop.index }}"
                      data-quantity="{{ item.quantity | minus: 1 }}"
                      aria-label="-"
                    >&minus;</button>
                    <input type="number" value="{{ item.quantity }}" min="0" readonly aria-label="{{ 'products.product.quantity' | t }}">
                    <button
                      type="button"
                      data-cart-change
                      data-line="{{ forloop.index }}"
                      data-quantity="{{ item.quantity | plus: 1 }}"
                      aria-label="+"
                    >+</button>
                  </div>
                  <span>{{ item.final_line_price | money }}</span>
                </div>
                <button type="button" class="cart-item__remove" data-cart-change data-line="{{ forloop.index }}" data-quantity="0">
                  {{ 'sections.cart.remove_title' | t: title: item.product.title }}
                </button>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <aside class="cart-page__summary">
          <div class="cart-drawer__subtotal">
            <span>{{ 'sections.cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-drawer__note">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="button button--full-width">
              {{ 'sections.cart.checkout' | t }}
            </button>
          </form>
        </aside>
      </div>
    {%- else -%}
      <div class="empty-state">
        <h2>{{ 'sections.cart.empty' | t }}</h2>
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
