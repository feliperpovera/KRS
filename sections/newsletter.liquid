<div class="section-padding">
  <div class="page-width">
    <div class="newsletter scroll-trigger">
      <h2>{{ section.settings.heading | escape }}</h2>
      <p style="opacity:.75">{{ section.settings.text | escape }}</p>
      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          required
          placeholder="{{ 'newsletter.label' | t }}"
          aria-label="{{ 'newsletter.label' | t }}"
          autocomplete="email"
        >
        <button type="submit" class="button">{{ 'newsletter.button_label' | t }}</button>
      {%- endform -%}
      {%- form 'customer' -%}
        {%- if form.posted_successfully? -%}
          <p role="status">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Email signup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Join the KRS world"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Be the first to know about launches, restocks and exclusive offers."
    }
  ],
  "presets": [
    {
      "name": "Email signup"
    }
  ]
}
{% endschema %}
