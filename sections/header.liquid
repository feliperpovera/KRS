{%- style -%}
  .header__logo img {
    max-height: {{ section.settings.logo_height | default: 40 }}px;
  }
  @media screen and (max-width: 749px) {
    .header__logo img {
      max-height: {{ section.settings.logo_height_mobile | default: 28 }}px;
    }
  }
{%- endstyle -%}

<sticky-header class="header-wrapper">
  <header class="header page-width">
    <div style="display:flex;align-items:center;gap:1rem;">
      <drawer-toggle data-target="MenuDrawer" class="header__menu-toggle">
        <button class="header__icon" aria-label="{{ 'accessibility.open_menu' | t }}" aria-controls="MenuDrawer">
          {% render 'icon', icon: 'hamburger' %}
        </button>
      </drawer-toggle>

      <nav class="header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
        {%- for link in section.settings.menu.links -%}
          <div class="nav-item{% if link.links.size > 0 %} nav-item--mega{% endif %}">
            <a href="{{ link.url }}" class="nav-item__link" {% if link.links.size > 0 %}aria-expanded="false" aria-haspopup="true"{% endif %}>
              {{ link.title | escape }}
            </a>
            {%- if link.links.size > 0 -%}
              <div class="mega-menu">
                <div class="mega-menu__inner">
                  {%- for childlink in link.links -%}
                    <div>
                      <p class="mega-menu__column-title">
                        <a href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                      </p>
                      {%- if childlink.links.size > 0 -%}
                        <ul class="mega-menu__list">
                          {%- for grandchildlink in childlink.links -%}
                            <li><a href="{{ grandchildlink.url }}">{{ grandchildlink.title | escape }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.settings.sale_label != blank -%}
          <div class="nav-item nav-item--sale{% if section.settings.sale_menu != blank %} nav-item--mega{% endif %}">
            <a href="{{ section.settings.sale_link | default: routes.all_products_collection_url }}" class="nav-item__link">
              {{ section.settings.sale_label | escape }}
            </a>
            {%- if section.settings.sale_menu != blank -%}
              <div class="mega-menu">
                <div class="mega-menu__inner">
                  <div>
                    <p class="mega-menu__column-title">{{ section.settings.sale_label | escape }}</p>
                    <ul class="mega-menu__list">
                      {%- for link in section.settings.sale_menu.links -%}
                        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </nav>
    </div>

    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        {%- if section.settings.logo_mobile != blank -%}
          <picture>
            <source media="(max-width: 749px)" srcset="{{ section.settings.logo_mobile | image_url: width: 400 }}">
            {{
              section.settings.logo
              | image_url: width: 600
              | image_tag: alt: shop.name, width: section.settings.logo.width, height: section.settings.logo.height
            }}
          </picture>
        {%- else -%}
          {{
            section.settings.logo
            | image_url: width: 600
            | image_tag: alt: shop.name, width: section.settings.logo.width, height: section.settings.logo.height
          }}
        {%- endif -%}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <div class="header__icons">
      <drawer-toggle data-target="SearchModal">
        <button class="header__icon" aria-label="{{ 'accessibility.open_search' | t }}" aria-controls="SearchModal">
          {% render 'icon', icon: 'search' %}
        </button>
      </drawer-toggle>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon" aria-label="{{ 'accessibility.account' | t }}">
          {% render 'icon', icon: 'account' %}
        </a>
      {%- endif -%}

      <drawer-toggle data-target="CartDrawer">
        <button class="header__icon" aria-label="{{ 'accessibility.cart' | t }}" aria-controls="CartDrawer">
          {% render 'icon', icon: 'cart' %}
          <span id="cart-icon-bubble">
            {%- if cart.item_count > 0 -%}
              <span class="cart-count-bubble" aria-hidden="true">{{ cart.item_count }}</span>
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            {%- endif -%}
          </span>
        </button>
      </drawer-toggle>
    </div>
  </header>
</sticky-header>

{%- comment -%} Menú móvil {%- endcomment -%}
<div id="MenuDrawer" class="menu-drawer" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
  <div class="menu-drawer__overlay" data-drawer-close></div>
  <div class="menu-drawer__panel">
    <button class="menu-drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon', icon: 'close' %}
    </button>
    <nav class="menu-drawer__nav">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links.size > 0 -%}
          <details>
            <summary>{{ link.title | escape }}</summary>
            <ul class="menu-drawer__sublist">
              {%- for childlink in link.links -%}
                <li><a href="{{ childlink.url }}">{{ childlink.title | escape }}</a></li>
                {%- for grandchildlink in childlink.links -%}
                  <li><a href="{{ grandchildlink.url }}">&mdash; {{ grandchildlink.title | escape }}</a></li>
                {%- endfor -%}
              {%- endfor -%}
            </ul>
          </details>
        {%- else -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.sale_label != blank -%}
        {%- if section.settings.sale_menu != blank -%}
          <details>
            <summary style="color: {{ settings.color_sale }};">{{ section.settings.sale_label | escape }}</summary>
            <ul class="menu-drawer__sublist">
              {%- for link in section.settings.sale_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </details>
        {%- else -%}
          <a href="{{ section.settings.sale_link | default: routes.all_products_collection_url }}" style="color: {{ settings.color_sale }};">
            {{ section.settings.sale_label | escape }}
          </a>
        {%- endif -%}
      {%- endif -%}
    </nav>
  </div>
</div>

{%- comment -%} Modal de búsqueda {%- endcomment -%}
<div id="SearchModal" class="search-modal" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form page-width">
    <input
      type="search"
      name="q"
      placeholder="{{ 'general.search.placeholder' | t }}"
      aria-label="{{ 'general.search.search' | t }}"
    >
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="button">{{ 'general.search.search' | t }}</button>
    <button type="button" class="header__icon" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon', icon: 'close' %}
    </button>
  </form>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (desktop)"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "Logo (mobile)",
      "info": "Optional. Use the K seal or a shorter mark for small screens. Falls back to the desktop logo."
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo height (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Logo height (mobile)",
      "default": 28
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Sale menu"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Sale menu label",
      "default": "Sale",
      "info": "Highlighted in the theme's sale color. Leave empty to hide it."
    },
    {
      "type": "url",
      "id": "sale_link",
      "label": "Main sale link",
      "info": "Point it to the Outlet collection."
    },
    {
      "type": "link_list",
      "id": "sale_menu",
      "label": "Sale dropdown menu",
      "info": "Create a navigation menu (e.g. Outlet, Last sizes, Sets on sale) and select it here."
    }
  ]
}
{% endschema %}
