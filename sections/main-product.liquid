<div class="page-width">
  <div class="product">
    <div class="product__gallery">
      <ul class="product__media-list" role="list">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <li>
              <div class="product__media">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {%- liquid
                      assign media_loading = 'lazy'
                      if forloop.first
                        assign media_loading = 'eager'
                      endif
                    -%}
                    {{
                      media
                      | image_url: width: 1500
                      | image_tag: loading: media_loading, sizes: '(min-width: 990px) 55vw, 100vw', widths: '550, 750, 1100, 1500', alt: media.alt
                    }}
                  {%- when 'video', 'external_video' -%}
                    {{ media | media_tag: autoplay: false, controls: true }}
                  {%- when 'model' -%}
                    {{ media | media_tag }}
                {%- endcase -%}
              </div>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><div class="product__media">{{ 'product-apparel-1' | placeholder_svg_tag }}</div></li>
          <li><div class="product__media">{{ 'product-apparel-2' | placeholder_svg_tag }}</div></li>
        {%- endif -%}
      </ul>
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            <p class="product-card__vendor" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div class="product__price" {{ block.shopify_attributes }}>
              {% render 'price', product: product %}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <variant-selects {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_key = option.name | downcase
                    assign is_swatch = false
                    if option_key contains 'color' or option_key contains 'colour'
                      assign is_swatch = true
                    endif
                  -%}
                  <fieldset class="product-form__input">
                    <legend class="product-form__label">
                      {{ option.name | escape }}
                      {%- if is_swatch and option.selected_value != blank -%}
                        <span class="product-form__selected" data-selected-for="{{ option.position }}">
                          {{ option.selected_value | escape }}
                        </span>
                      {%- endif -%}
                    </legend>
                    <div class="variant-options{% if is_swatch %} variant-options--swatch{% endif %}">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign swatch_style = ''
                          if is_swatch
                            if value.swatch.image != blank
                              assign swatch_image = value.swatch.image | image_url: width: 120
                              assign swatch_style = 'background-image:url(' | append: swatch_image | append: ')'
                            elsif value.swatch.color != blank
                              assign swatch_style = 'background-color:' | append: value.swatch.color
                            else
                              assign value_key = value | downcase | strip
                              assign swatch_hex = ''
                              assign swatch_pairs = settings.color_swatches | newline_to_br | split: '<br />'
                              for pair in swatch_pairs
                                assign kv = pair | strip | split: ':'
                                if kv.size == 2
                                  assign kv_name = kv[0] | downcase | strip
                                  if kv_name == value_key
                                    assign swatch_hex = kv[1] | strip
                                    break
                                  endif
                                endif
                              endfor
                              if swatch_hex == blank
                                assign swatch_hex = value_key | replace: ' ', '' | replace: '-', ''
                              endif
                              assign swatch_style = 'background-color:' | append: swatch_hex
                            endif
                          endif
                        -%}
                        <input
                          type="radio"
                          id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label
                          for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                          {% if is_swatch %}
                            class="swatch"
                            style="{{ swatch_style }}"
                            title="{{ value | escape }}"
                          {% endif %}
                        >
                          {%- if is_swatch -%}
                            <span class="visually-hidden">{{ value | escape }}</span>
                          {%- else -%}
                            {{ value | escape }}
                          {%- endif -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <script type="application/json">
                  [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id }},
                        "available": {{ variant.available }},
                        "options": {{ variant.options | json }},
                        "price": {{ variant.price }},
                        "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                        "price_formatted": {{ variant.price | money | json }},
                        "compare_at_price_formatted": {{ variant.compare_at_price | money | json }}
                      }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]
                </script>
              </variant-selects>
            {%- endunless -%}

          {%- when 'quantity_selector' -%}
            <div class="product-form__input" {{ block.shopify_attributes }}>
              <label class="product-form__label" for="Quantity-{{ section.id }}">
                {{ 'products.product.quantity' | t }}
              </label>
              <quantity-input class="quantity">
                <button type="button" name="minus" aria-label="-">&minus;</button>
                <input
                  type="number"
                  id="Quantity-{{ section.id }}"
                  name="quantity"
                  value="1"
                  min="1"
                  form="ProductForm-{{ section.id }}"
                >
                <button type="button" name="plus" aria-label="+">+</button>
              </quantity-input>
            </div>

          {%- when 'buy_buttons' -%}
            <product-form {{ block.shopify_attributes }}>
              {%- liquid
                assign product_form_id = 'ProductForm-' | append: section.id
              -%}
              {%- form 'product', product, id: product_form_id, novalidate: 'novalidate' -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ product.selected_or_first_available_variant.id }}"
                >
                <button
                  type="submit"
                  name="add"
                  class="button button--full-width"
                  {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                >
                  <span>
                    {%- if product.selected_or_first_available_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  <span class="loading-overlay__spinner hidden" style="margin-left:1rem;"></span>
                </button>
              {%- endform -%}
              {%- if block.settings.show_dynamic_checkout -%}
                {%- form 'product', product -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_button }}
                {%- endform -%}
              {%- endif -%}
            </product-form>

          {%- when 'description' -%}
            <div class="product__description rte" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>

          {%- when 'collapsible_tab' -%}
            <div class="product__accordions" {{ block.shopify_attributes }}>
              <details>
                <summary>{{ block.settings.heading | escape }}</summary>
                <div class="accordion__content rte">{{ block.settings.content }}</div>
              </details>
            </div>

          {%- when 'share' -%}
            <br>
            <a
              href="#"
              class="link-underline"
              onclick="navigator.share ? navigator.share({ url: window.location.href, title: document.title }) : navigator.clipboard.writeText(window.location.href); return false;"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.share_label | default: 'Share' | escape }}
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main product",
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "quantity_selector", "name": "Quantity selector", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": true
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "default": "Details & care"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenido",
          "default": "<p>Add fabric composition, care guide or shipping details here.</p>"
        }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "label": "Label",
          "default": "Share"
        }
      ]
    }
  ]
}
{% endschema %}
