<div class="page-width section-padding">
  <h1 style="text-align:center">{{ 'templates.list_collections.title' | t }}</h1>
  <div class="tile-grid tile-grid--3">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="tile scroll-trigger">
        {%- if collection.featured_image != blank -%}
          {{
            collection.featured_image
            | image_url: width: 900
            | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 50vw', alt: collection.title
          }}
        {%- else -%}
          {{ 'collection-apparel-2' | placeholder_svg_tag }}
        {%- endif -%}
        <span class="tile__label">{{ collection.title | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Lista de colecciones",
  "settings": []
}
{% endschema %}
