<div class="hero hero--{{ section.settings.height }}">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true
      }}
    {%- elsif section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
              {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w,
              {{ section.settings.image_mobile | image_url: width: 1600 }} 1600w
            "
            sizes="100vw"
          >
          {{
            section.settings.image
            | image_url: width: 3000
            | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2200, 3000', alt: section.settings.image.alt
          }}
        </picture>
      {%- else -%}
        {{
          section.settings.image
          | image_url: width: 3000
          | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2200, 3000', alt: section.settings.image.alt
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content page-width{% if section.settings.alignment == 'center' %} hero__content--center{% endif %}">
    <div class="scroll-trigger">
      {%- if section.settings.subheading != blank -%}
        <p style="letter-spacing:.2em;text-transform:uppercase;font-size:1.2rem;margin:0 0 1rem;">
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hero__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hero__subheading">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="hero__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 }}" class="button">{{ section.settings.button_label_1 | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">{{ section.settings.button_label_2 | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (desktop)",
      "info": "Recommended: 3000 x 1800 px. A placeholder shows if empty."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile)",
      "info": "Vertical crop for phones. Recommended: 1200 x 1600 px. Falls back to the desktop image if empty."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video (optional)",
      "info": "Replaces the image when set."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow",
      "default": "New collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Move beautifully"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Premium activewear designed to move with you all day."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Button 1 label",
      "default": "Shop new in"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 label",
      "default": "Best sellers"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
