{%- assign recs = product.metafields.custom.complete_the_look.value -%}
{%- if recs != blank -%}
  <div class="section-padding">
    <div class="page-width">
      <div class="section-header"><h2 class="section-header__title">{{ section.settings.heading | escape }}</h2></div>
      <div class="product-grid product-grid--3">
        {%- for rec in recs -%}
          {% render 'product-card', card_product: rec %}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Complete the look",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" }],
  "presets": [{ "name": "Complete the look" }]
}
{% endschema %}
