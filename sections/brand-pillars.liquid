<div class="section-padding" style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header scroll-trigger" style="justify-content:center;">
        <h2 class="section-header__title">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    <div class="pillars">
      {%- for block in section.blocks -%}
        <div class="pillar scroll-trigger" {{ block.shopify_attributes }}>
          <p class="pillar__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
          <h3 class="pillar__title">{{ block.settings.title | escape }}</h3>
          <p class="pillar__text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand pillars",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "We care about every detail"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quality"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "We never compromise on what we deliver."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Own fabrication", "text": "We develop our own fabrics." } },
        { "type": "pillar", "settings": { "title": "Own design", "text": "Every piece is designed with intention." } },
        { "type": "pillar", "settings": { "title": "Detail", "text": "We control every step of the process." } },
        { "type": "pillar", "settings": { "title": "Quality", "text": "We never compromise on what we deliver." } }
      ]
    }
  ]
}
{% endschema %}
