[
  {
    "name": "theme_info",
    "theme_name": "Studio Athleisure",
    "theme_version": "1.0.0",
    "theme_author": "RevUp Agency Group",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Fondo",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texto",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Botones (fondo)",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Botones (texto)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Precio en oferta",
        "default": "#B3261E"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Bordes y líneas",
        "default": "#E5E2DD"
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Fuente de encabezados",
        "default": "assistant_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Fuente de cuerpo",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Diseño",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1800,
        "step": 100,
        "unit": "px",
        "label": "Ancho máximo de página",
        "default": 1600
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Radio de botones",
        "default": 0
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Radio de tarjetas e imágenes",
        "default": 0
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Imagen de favicon",
        "info": "Se reducirá a 32 x 32 px"
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube"
      }
    ]
  }
